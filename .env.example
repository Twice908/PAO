# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────────────
# Matches docker-compose.yml credentials (user/password/db = pao)
DATABASE_URL=postgresql://pao:pao@localhost:5432/pao

# ── Redis (BullMQ queue + pub/sub for live agent run streaming) ───────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Auth (dashboard + JWT verification on the SSE stream route) ─────────
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Ingestion API ─────────────────────────────────────────────────────────────
# Base URL of apps/api — used by the dashboard SSE proxy route
INGESTION_API_URL=http://localhost:3001
# Port apps/api listens on (default 3001)
PORT=3001

# ── Resend (email alert notifications — optional) ─────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
