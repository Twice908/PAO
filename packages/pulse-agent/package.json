{
  "name": "@pulse/agent",
  "version": "0.1.0",
  "description": "Pulse Agent Observe (PAO) SDK for AI agent observability",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
